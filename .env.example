# Copy to .env and fill in. `make setup` does the copy for you.
# Every key here is read by src/assay/config.py — nothing listed is decorative.

# --- Credentials -------------------------------------------------------------
# Not needed for `make profile`, `make ingest`, or the offline test suite.
OPENAI_API_KEY=sk-...

# --- Model -------------------------------------------------------------------
ASSAY_GENERATION_MODEL=gpt-4o-mini

# --- Paths -------------------------------------------------------------------
ASSAY_RAW_DIR=data/raw
ASSAY_WAREHOUSE=data/warehouse/shipments.duckdb

# --- Query limits ------------------------------------------------------------
# Cap on rows returned to the model for summarising. A question whose answer is
# 50,000 rows is a question that needed aggregating, not paginating.
ASSAY_MAX_ROWS=200
